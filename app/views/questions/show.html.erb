<% page_title @question.title %>

<article class="mx-auto w-full max-w-3xl">
  <nav class="mb-6 text-sm text-slate-500">
    <%= link_to "Questions", questions_path, class: "hover:text-cyan-400 transition" %>
    <span class="mx-1.5 text-slate-700">/</span>
    <% if @question.category %>
      <%= link_to @question.category.name, category_path(@question.category), class: "hover:text-cyan-400 transition" %>
      <span class="mx-1.5 text-slate-700">/</span>
    <% end %>
    <span class="text-slate-400">Detail</span>
  </nav>

  <header class="border-b border-slate-800 pb-6">
    <div class="flex flex-wrap items-center gap-2">
      <%= difficulty_badge(@question.difficulty) %>
      <% if @question.interview_type.present? %>
        <span class="rounded-md bg-slate-800 px-2 py-0.5 text-[11px] uppercase tracking-wide text-slate-400"><%= @question.interview_type.humanize %></span>
      <% end %>
      <% if @completed %>
        <span class="rounded-md bg-emerald-500/15 px-2 py-0.5 text-[11px] font-medium uppercase tracking-wide text-emerald-400">Completed</span>
      <% end %>
      <% if @bookmarked %>
        <span class="rounded-md bg-amber-500/15 px-2 py-0.5 text-[11px] font-medium uppercase tracking-wide text-amber-400">Bookmarked</span>
      <% end %>
    </div>

    <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-50 sm:text-3xl"><%= @question.title %></h1>

    <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-sm text-slate-500">
      <% if @question.category %>
        <span><%= link_to @question.category.name, category_path(@question.category), class: "text-slate-400 hover:text-cyan-400 transition" %></span>
      <% end %>
      <% if @question.company.present? %><span><%= @question.company %></span><% end %>
      <% if @question.source.present? %><span><%= @question.source %></span><% end %>
      <% if @question.estimated_minutes.present? %><span><%= @question.estimated_minutes %> min</span><% end %>
    </p>

    <div class="mt-5 flex flex-wrap gap-2">
      <%= button_to (@bookmarked ? "Remove bookmark" : "Bookmark"),
            toggle_bookmark_question_path(@question),
            method: :post,
            class: "cursor-pointer rounded-lg border border-slate-700 bg-slate-900 px-4 py-2 text-sm text-slate-200 hover:border-amber-500/50 hover:text-amber-300 transition" %>
      <%= button_to (@completed ? "Mark incomplete" : "Mark complete"),
            toggle_complete_question_path(@question),
            method: :post,
            class: "cursor-pointer rounded-lg bg-cyan-500 px-4 py-2 text-sm font-medium text-slate-950 hover:bg-cyan-400 transition" %>
      <%= link_to "Back to list", questions_path, class: "inline-flex items-center rounded-lg border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:border-slate-500 transition" %>
    </div>
  </header>

  <% if @question.body.present? %>
    <section class="mt-8">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Prompt</h2>
      <div class="mt-3 text-sm leading-relaxed text-slate-300 sm:text-base"><%= formatted_content(@question.body) %></div>
    </section>
  <% end %>

  <section class="mt-8 rounded-xl border border-cyan-500/25 bg-cyan-500/5 p-5 sm:p-6">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-cyan-400">Model answer</h2>
    <div class="mt-3 text-sm leading-relaxed text-slate-100 sm:text-base">
      <%= formatted_content(@question.best_answer.presence || @question.answer) %>
    </div>
    <% if @question.alternative_answer.present? %>
      <h3 class="mt-6 text-xs font-semibold uppercase tracking-wider text-slate-500">Alternative answer</h3>
      <div class="mt-2 text-sm leading-relaxed text-slate-300"><%= formatted_content(@question.alternative_answer) %></div>
    <% end %>
  </section>

  <% if @question.theory.present? || @question.practical.present? %>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      <% if @question.theory.present? %>
        <section class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Theory</h2>
          <div class="mt-2 text-sm text-slate-300"><%= formatted_content(@question.theory) %></div>
        </section>
      <% end %>
      <% if @question.practical.present? %>
        <section class="rounded-xl border border-slate-800 bg-slate-900/40 p-4">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Practical</h2>
          <div class="mt-2 text-sm text-slate-300"><%= formatted_content(@question.practical) %></div>
        </section>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8">
    <%= render "questions/details", question: @question, related: @related %>
  </div>
</article>
