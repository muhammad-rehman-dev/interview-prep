<% page_title "Categories" %>

<section class="mx-auto w-full max-w-5xl">
  <header class="mb-8">
    <p class="text-xs font-medium uppercase tracking-[0.2em] text-cyan-400/80">Curriculum map</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-50 sm:text-4xl">Categories</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-400 sm:text-base">
      Work through topic tracks at your own pace. Each category surfaces the questions you need for senior backend rounds.
    </p>
  </header>

  <% if @categories.any? %>
    <div class="grid gap-4 sm:grid-cols-2">
      <% @categories.each do |category| %>
        <% count = category.questions.size %>
        <%= link_to category_path(category), class: "group block rounded-xl border border-slate-800 bg-slate-900/40 p-5 transition hover:border-cyan-500/40 hover:bg-slate-900/70" do %>
          <div class="flex items-start justify-between gap-3">
            <div>
              <% if category.icon.present? %>
                <span class="mb-2 block text-lg text-cyan-400/80" aria-hidden="true"><%= category.icon %></span>
              <% end %>
              <h2 class="text-lg font-medium text-slate-100 group-hover:text-cyan-300 transition"><%= category.name %></h2>
            </div>
            <span class="shrink-0 rounded-full border border-slate-700 bg-slate-950 px-2.5 py-1 text-xs font-medium text-slate-400">
              <%= count %>
            </span>
          </div>
          <% if category.description.present? %>
            <p class="mt-2 line-clamp-2 text-sm text-slate-500"><%= category.description %></p>
          <% end %>
          <p class="mt-4 text-xs uppercase tracking-wider text-slate-600 group-hover:text-cyan-500/70 transition">
            <%= count.zero? ? "Coming soon" : "#{count} #{'question'.pluralize(count)}" %>
          </p>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <%= empty_state(
          title: "No categories yet",
          body: "Categories will appear once the curriculum is loaded. Check back after seeding content.",
          cta: "Browse questions",
          href: questions_path
        ) %>
  <% end %>
</section>
