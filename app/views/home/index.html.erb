<% page_title "Home" %>

<div class="home-page">
  <div class="home-atmosphere" aria-hidden="true"></div>
  <div class="home-scanline" aria-hidden="true"></div>

  <header class="home-nav">
    <%= link_to root_path, class: "home-nav-brand" do %>
      <span>Backend</span>Forge
    <% end %>
    <div style="display:flex; gap:0.5rem; align-items:center;">
      <button type="button" class="btn btn-ghost" data-action="dark-mode#toggle" aria-label="Toggle theme">
        <span data-dark-mode-target="label">Light</span>
      </button>
      <%= link_to "Dashboard", dashboard_path, class: "btn btn-secondary" %>
    </div>
  </header>

  <main class="home-hero">
    <h1 class="home-brand"><span>Backend</span>Forge</h1>
    <p class="home-headline">Senior backend interviews, forged for production.</p>
    <p class="home-support">
      Drill Node, Nest, SQL, system design, and Rails→Node translation with curated questions, live coding, and timed mocks.
    </p>
    <div class="home-cta">
      <%= link_to "Start practicing", dashboard_path, class: "btn btn-primary" %>
      <%= link_to "Browse questions", questions_path, class: "btn btn-secondary" %>
    </div>
  </main>

  <p class="home-mono-glow" aria-hidden="true">
    const prep = await forge.interview({ level: "senior" })
  </p>
</div>
